[Unit]
Description=Conceal pool: public API (127.0.0.1:8146)
After=ccx-pool-redis.service ccx-node.service ccx-wallet-rpc.service
Requires=ccx-pool-redis.service
[Service]
Type=simple
User=ccxpool
WorkingDirectory=/opt/conceal-nodejs-pool
ExecStart=/usr/bin/node /opt/conceal-nodejs-pool/init.js -module=api
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
