[Unit]
Description=Conceal pool: payment processor (sendTransaction from the pool wallet; emergency brake: deployment/pause-payments.sh)
After=ccx-pool-redis.service ccx-node.service ccx-wallet-rpc.service
Requires=ccx-pool-redis.service
[Service]
Type=simple
User=ccxpool
WorkingDirectory=/opt/conceal-nodejs-pool
ExecStart=/usr/bin/node /opt/conceal-nodejs-pool/init.js -module=payments
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
